    <ProjectReference Include="..\..\src\ArChrono.Recovery\ArChrono.Recovery.csproj" />
    <ProjectReference Include="..\..\src\ArChrono.AI\ArChrono.AI.csproj" />
    <ProjectReference Include="..\..\src\ArChrono.Platform\ArChrono.Platform.csproj" />
    <ProjectReference Include="..\..\src\ArChrono.Application\ArChrono.Application.csproj" />
    <ProjectReference Include="..\..\src\ArChrono.App\ArChrono.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
