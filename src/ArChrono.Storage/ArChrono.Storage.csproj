<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArChrono.Storage</RootNamespace>
    <Description>Uygulama metadata'sı için SQLite depolama (ADR-0006).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="ArChrono.Storage.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArChrono.Tests" />
  </ItemGroup>

</Project>
