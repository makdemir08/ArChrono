<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ArChrono</AssemblyName>
    <RootNamespace>ArChrono.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- MVVM Toolkit: partial property önerisi (C# 13+) zaten kullanılıyor. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArChrono.Application\ArChrono.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\ArSoftLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArChrono.Tests" />
    <InternalsVisibleTo Include="ArChrono.Screenshots" />
  </ItemGroup>

</Project>
