<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArChrono.App.ViewModels.Dialogs"
             xmlns:l="using:ArChrono.App.Localization"
             x:Class="ArChrono.App.Views.Dialogs.TextInputDialogView"
             x:DataType="vm:TextInputDialogViewModel">
  <StackPanel Margin="22,6,22,20" Spacing="12">
    <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Spacing="6">
      <TextBlock Classes="meta" Text="{Binding Label}" />
      <TextBox Name="Input" Text="{Binding Text}" AcceptsReturn="{Binding IsMultiline}" />
      <TextBlock Classes="danger" FontSize="12" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
    </StackPanel>
    <CheckBox Content="{Binding OptionText}" IsChecked="{Binding Option}" IsVisible="{Binding HasOption}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{l:Loc 'Cancel', 'İptal'}" Command="{Binding CancelCommand}" />
      <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
