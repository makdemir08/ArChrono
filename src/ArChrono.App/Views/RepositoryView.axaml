<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArChrono.App.ViewModels"
             xmlns:views="using:ArChrono.App.Views"
             xmlns:c="using:ArChrono.App.Controls"
             xmlns:l="using:ArChrono.App.Localization"
             x:Class="ArChrono.App.Views.RepositoryView"
             x:DataType="vm:RepositoryViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- ÜST ÇUBUK -->
    <Border Grid.Row="0" Classes="panel divider-bottom" Padding="10,8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Repository -->
        <Button Classes="ghost" Padding="8,5" Command="{Binding Shell.CloseRepositoryCommand}" ToolTip.Tip="{Binding RootPath}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Chrono.SafeMuted}">
              <c:IconView Data="{StaticResource Icon.TimeMachine}" Foreground="{DynamicResource Chrono.Safe}" Width="14" Height="14" />
            </Border>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Chrono.TextPrimary}" />
            <c:IconView Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" Foreground="{DynamicResource Chrono.TextTertiary}" />
          </StackPanel>
        </Button>

        <!-- Branch -->
        <Button Grid.Column="1" Classes="ghost" Padding="8,5" Margin="4,0,0,0" Command="{Binding Shell.OpenCommandPaletteCommand}" ToolTip.Tip="{l:Loc 'Switch branch (⌘K, then @)', 'Branch değiştir (⌘K, sonra @)'}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:IconView Data="{StaticResource Icon.Branch}" Foreground="{DynamicResource Chrono.Safe}" />
            <TextBlock Text="{Binding BranchDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource Chrono.TextPrimary}" FontWeight="Medium" />
            <Border Classes="badge" Margin="2,0,0,0">
              <TextBlock Text="{Binding SyncHint}" Foreground="{DynamicResource Chrono.TextSecondary}" />
            </Border>
          </StackPanel>
        </Button>

        <!-- Senkronizasyon -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="10,0,0,0">
          <Button Classes="icon" Command="{Binding FetchCommand}" ToolTip.Tip="{l:Loc 'Fetch — check the server for new changes (⌥⌘F)', 'Fetch — sunucuda yeni değişiklikleri kontrol et (⌥⌘F)'}">
            <c:IconView Data="{StaticResource Icon.Fetch}" />
          </Button>
          <Button Classes="icon" Command="{Binding PullCommand}" ToolTip.Tip="{l:Loc 'Pull — get the latest changes (⌥⌘L)', 'Pull — son değişiklikleri al (⌥⌘L)'}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:IconView Data="{StaticResource Icon.Pull}" />
              <TextBlock Text="{Binding Behind}" FontSize="11" IsVisible="{Binding HasBehind}" VerticalAlignment="Center" Foreground="{DynamicResource Chrono.TextSecondary}" />
            </StackPanel>
          </Button>
          <Button Classes="icon" Command="{Binding PushCommand}" ToolTip.Tip="{l:Loc 'Push — send your commits to the server (⌥⌘P)', 'Push — commit\'lerinizi sunucuya gönderin (⌥⌘P)'}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:IconView Data="{StaticResource Icon.Push}" />
              <TextBlock Text="{Binding Ahead}" FontSize="11" IsVisible="{Binding HasAhead}" VerticalAlignment="Center" Foreground="{DynamicResource Chrono.TextSecondary}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Arama / komut paleti -->
        <Button Grid.Column="3" HorizontalAlignment="Stretch" MaxWidth="520" Margin="18,0" Padding="12,6"
                Background="{DynamicResource Chrono.Input}" BorderBrush="{DynamicResource Chrono.BorderSubtle}" BorderThickness="1"
                HorizontalContentAlignment="Stretch" Command="{Binding Shell.OpenCommandPaletteCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:IconView Data="{StaticResource Icon.Search}" Foreground="{DynamicResource Chrono.TextTertiary}" Width="14" Height="14" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{l:Loc 'Search or run a command…', 'Ara veya bir komut çalıştır…'}" Foreground="{DynamicResource Chrono.TextTertiary}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="badge">
              <TextBlock Text="⌘K" Foreground="{DynamicResource Chrono.TextTertiary}" />
            </Border>
          </Grid>
        </Button>

        <!-- Undo · snapshot · mod · ayarlar -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <Button Classes="time" Padding="10,5" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTitle}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <c:IconView Data="{StaticResource Icon.Undo}" Foreground="{DynamicResource Chrono.Time}" />
              <TextBlock Text="{Binding UndoTitle}" MaxWidth="220" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Chrono.Time}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTitle}">
            <c:IconView Data="{StaticResource Icon.Redo}" />
          </Button>
          <Button Classes="icon" Command="{Binding SaveSnapshotCommand}" ToolTip.Tip="{l:Loc 'Save a snapshot of your work now', 'Çalışmanızın anlık görüntüsünü şimdi kaydedin'}">
            <c:IconView Data="{StaticResource Icon.Snapshot}" Foreground="{DynamicResource Chrono.Safe}" />
          </Button>
          <Border Background="{DynamicResource Chrono.Input}" CornerRadius="7" Padding="2" Margin="6,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsGuided, Mode=OneWay}" Command="{Binding Shell.SetGuidedCommand}"
                           ToolTip.Tip="{l:Loc 'Plain language and explanations', 'Sade dil ve açıklamalar'}" Content="{l:Loc 'Guided', 'Rehberli'}" />
              <RadioButton Classes="segment" GroupName="mode" IsChecked="{Binding IsPro, Mode=OneWay}" Command="{Binding Shell.SetProCommand}"
                           ToolTip.Tip="{l:Loc 'Git terminology and commands', 'Git terimleri ve komutları'}" Content="Pro" />
            </StackPanel>
          </Border>
          <views:ShellToolbar DataContext="{Binding Shell}" Margin="4,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Yarım kalmış işlem banner'ı -->
    <Border Grid.Row="1" Classes="banner" IsVisible="{Binding IsOperationInProgress}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:IconView Data="{StaticResource Icon.Conflict}" Foreground="{DynamicResource Chrono.Time}" Width="18" Height="18" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding StateTitle}" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" Text="{Binding StateDetail}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{l:Loc 'Resolve', 'Çöz'}" Command="{Binding ShowConflictsCommand}" IsVisible="{Binding HasConflicts}" />
          <Button Classes="primary" Content="{l:Loc 'Continue', 'Devam et'}" Command="{Binding ContinueCommand}" />
          <Button Content="{l:Loc 'Abort', 'İptal et'}" Command="{Binding AbortCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- GÖVDE -->
    <Grid Grid.Row="2" ColumnDefinitions="56,*">
      <Border Classes="divider-right" Background="{DynamicResource Chrono.Rail}">
        <DockPanel Margin="0,10">
          <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Spacing="2">
            <Button Classes="icon" Width="40" Height="40" Command="{Binding ToggleConsoleCommand}" ToolTip.Tip="{l:Loc 'Git Console (⌘`)', 'Git Konsolu (⌘`)'}">
              <c:IconView Data="{StaticResource Icon.Terminal}" Width="18" Height="18" />
            </Button>
            <Button Classes="icon" Width="40" Height="40" Command="{Binding OpenTerminalCommand}" ToolTip.Tip="{l:Loc 'Open terminal here (⌘J)', 'Burada terminal aç (⌘J)'}">
              <c:IconView Data="{StaticResource Icon.Folder}" Width="18" Height="18" />
            </Button>
          </StackPanel>
          <StackPanel HorizontalAlignment="Center">
            <RadioButton Classes="rail" GroupName="section" IsChecked="{Binding IsWorkspace}" ToolTip.Tip="{l:Loc 'Workspace (⌘1)', 'Çalışma alanı (⌘1)'}">
              <c:IconView Data="{StaticResource Icon.Graph}" Width="20" Height="20" Foreground="{Binding $parent[RadioButton].Foreground}" />
            </RadioButton>
            <RadioButton Classes="rail" GroupName="section" IsChecked="{Binding IsRecovery}" ToolTip.Tip="{l:Loc 'Recovery Center (⌘2)', 'Kurtarma Merkezi (⌘2)'}">
              <c:IconView Data="{StaticResource Icon.Recovery}" Width="20" Height="20" Foreground="{Binding $parent[RadioButton].Foreground}" />
            </RadioButton>
            <RadioButton Classes="rail" GroupName="section" IsChecked="{Binding IsTimeMachine}" ToolTip.Tip="{l:Loc 'Time Machine (⌘3)', 'Zaman Makinesi (⌘3)'}">
              <c:IconView Data="{StaticResource Icon.TimeMachine}" Width="20" Height="20" Foreground="{Binding $parent[RadioButton].Foreground}" />
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel Grid.Column="1">
        <views:WorkspaceView DataContext="{Binding Workspace}" IsVisible="{Binding $parent[UserControl].((vm:RepositoryViewModel)DataContext).IsWorkspace}" />
        <views:RecoveryCenterView DataContext="{Binding Recovery}" IsVisible="{Binding $parent[UserControl].((vm:RepositoryViewModel)DataContext).IsRecovery}" />
        <views:TimeMachineView DataContext="{Binding TimeMachine}" IsVisible="{Binding $parent[UserControl].((vm:RepositoryViewModel)DataContext).IsTimeMachine}" />

        <Border IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12" Classes="card" Padding="14,8" BoxShadow="0 8 24 0 #44000000">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="60" MinWidth="60" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BusyText}" MaxWidth="480" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>

    <!-- Git Console -->
    <Border Grid.Row="3" Height="240" Classes="panel divider-top" IsVisible="{Binding IsConsoleOpen}">
      <views:ConsoleView DataContext="{Binding Console}" />
    </Border>

    <!-- CHRONO STRIP -->
    <Border Grid.Row="4" Classes="panel divider-top" Height="40" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="ghost" Padding="6,2" Command="{Binding GoToRecoveryCommand}" ToolTip.Tip="{l:Loc 'Open Recovery Center', 'Kurtarma Merkezi\'ni aç'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconView Data="{StaticResource Icon.TimeMachine}" Foreground="{DynamicResource Chrono.Time}" Width="14" Height="14" />
            <TextBlock Text="CHRONO" Classes="section" Foreground="{DynamicResource Chrono.Time}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <c:ChronoStrip Grid.Column="1" Name="Strip" Margin="8,0" Marks="{Binding ChronoMarks}" Start="{Binding ChronoStart}" End="{Binding ChronoEnd}" ShowLabels="False" />
        <TextBlock Grid.Column="2" Classes="meta" Text="{Binding ChronoSummary}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
